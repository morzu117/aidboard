#!/bin/bash
# Lanceur léger : ouvre un shell de connexion (zsh -i -l) pour que mise/PATH soient
# initialisés comme dans un terminal normal (Finder ne source aucun profil shell).
#
# Avant d'appeler `aid`, se place dans le dépôt installé (Contents/Resources/repo-path.txt,
# écrit par scripts/build.sh à l'install) : mise active alors la version de node que ce dépôt
# épingle, et c'est CE dépôt qui répond sur le PATH — sans ce `cd`, un autre aidboard lié
# globalement sur la machine (sous une autre version de node) peut passer devant et servir un
# vieux build, qui échoue sur des options qu'il ne connaît pas encore.
#
# `aid --cycle` : si un daemon tourne déjà, interrompt proprement ses agents (résumé écrit,
# repris après coup) avant de relancer — seule AID.app porte ce comportement, pas `aid` nu
# (scripts/hooks en dépendent pour sa réutilisation silencieuse habituelle).
set -e

DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_FILE="$DIR/../Resources/repo-path.txt"
if [ -f "$REPO_FILE" ]; then
  CD_PREFIX="cd \"$(cat "$REPO_FILE")\" && "
else
  CD_PREFIX=""
fi

if ! /bin/zsh -i -l -c "${CD_PREFIX}command -v aid" >/dev/null 2>&1; then
  osascript -e 'display alert "AID introuvable" message "La commande aid n’est pas sur le PATH (npm link manquant ou mise non initialisé)." as critical' >/dev/null 2>&1
  exit 1
fi

if ! /bin/zsh -i -l -c "${CD_PREFIX}aid --cycle"; then
  osascript -e 'display alert "AID n’a pas pu démarrer" message "Voir ~/.aid/daemon.log pour le détail." as critical' >/dev/null 2>&1
  exit 1
fi
