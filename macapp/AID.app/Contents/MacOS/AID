#!/bin/bash
# Lanceur léger : ouvre un shell de connexion (zsh -i -l) pour que mise/PATH soient
# initialisés comme dans un terminal normal (Finder ne source aucun profil shell), puis lance
# `aid --cycle` : si un daemon tourne déjà, interrompt proprement ses agents (résumé écrit,
# repris après coup) avant de relancer — seule AID.app porte ce comportement, pas `aid` nu
# (scripts/hooks en dépendent pour sa réutilisation silencieuse habituelle).
set -e

if ! /bin/zsh -i -l -c 'command -v aid' >/dev/null 2>&1; then
  osascript -e 'display alert "AID introuvable" message "La commande aid n’est pas sur le PATH (npm link manquant ou mise non initialisé)." as critical' >/dev/null 2>&1
  exit 1
fi

if ! /bin/zsh -i -l -c 'aid --cycle'; then
  osascript -e 'display alert "AID n’a pas pu démarrer" message "Voir ~/.aid/daemon.log pour le détail." as critical' >/dev/null 2>&1
  exit 1
fi
