{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AID",
  "version": "0.1.0",
  "identifier": "dev.aidboard.desktop",
  "build": {
    "frontendDist": "../loading"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/morzu117/aidboard/releases/latest/download/latest.json"],
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
