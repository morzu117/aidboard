#!/bin/sh

root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

needs_gate=false
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$needs_gate" = true ] && continue
    [ "$remote_ref" = refs/heads/main ] && continue
    case "$local_sha" in
        *[!0]*) ;;
        *) continue ;;
    esac

    case "$remote_sha" in
        *[!0]*) base=$remote_sha ;;
        *)
            if ! base=$(git merge-base "$local_sha" origin/main 2>/dev/null); then
                needs_gate=true
                continue
            fi
            ;;
    esac

    if ! changed=$(git diff --name-only --no-renames "$base..$local_sha" -- \
        . ':(exclude)docs/' ':(exclude)*.md') || [ -n "$changed" ]; then
        needs_gate=true
    fi
done

if [ "$needs_gate" = false ]; then
    echo 'pre-push : gate ignoré (aucun changement de code à vérifier)'
    exit 0
fi

if npm run gate < /dev/null; then
    echo 'pre-push : gate vert'
    exit 0
fi

echo 'pre-push : gate rouge, poussée refusée (git push --no-verify pour passer outre)' >&2
exit 1
