{
  "name": "aidboard",
  "version": "0.1.0",
  "description": "A-I-D Board : cockpit local des agents de code et des sujets en cours",
  "private": true,
  "type": "module",
  "bin": {
    "aidboard": "dist/cli/aid.js",
    "aid": "dist/cli/aid.js"
  },
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.daemon.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run",
    "build": "tsup && vite build web",
    "e2e": "playwright test",
    "gate": "npm run typecheck && npm run lint && npm run build && npm run test",
    "gate:e2e": "npm run build && AID_PACK_TEST=1 vitest run test/pack.test.ts test/package-server.test.ts && npm run e2e",
    "package:server": "scripts/package-server.sh",
    "dev:web": "vite web",
    "dev:daemon": "tsup && node --enable-source-maps dist/cli/aid.js daemon --foreground",
    "prepack": "npm run build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "@fontsource/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@sinclair/typebox": "^0.34.52",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "marked": "^18.1.1",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "sqlite-vec": "^0.1.9",
    "ulid": "^3.0.2",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "files": [
    "dist",
    "migrations",
    "kernel",
    "scripts/git",
    "scripts/hooks",
    "README.md"
  ],
  "keywords": [
    "agents",
    "claude-code",
    "codex",
    "worktree",
    "cockpit"
  ],
  "license": "MIT"
}
