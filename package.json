{
  "name": "aidboard",
  "version": "0.1.0",
  "description": "A-I-D Board : cockpit local des agents de code et des sujets en cours",
  "private": true,
  "type": "module",
  "bin": {
    "aidboard": "dist/cli/aid.js",
    "aid": "dist/cli/aid.js"
  },
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.daemon.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run",
    "build": "tsup && vite build web",
    "e2e": "playwright test",
    "gate": "npm run typecheck && npm run lint && npm run test && npm run build",
    "gate:e2e": "npm run build && npm run e2e",
    "dev:web": "vite web",
    "dev:daemon": "tsup && node --enable-source-maps dist/cli/aid.js daemon --foreground"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
