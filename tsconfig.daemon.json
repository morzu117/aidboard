{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "src/daemon",
    "src/cli",
    "src/shared",
    "test/**/*.ts",
    "tsup.config.ts",
    "vitest.config.ts",
    "e2e",
    "playwright.config.ts"
  ],
  "exclude": ["test/web"]
}
